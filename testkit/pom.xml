<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.mosip.vivid</groupId>
    <artifactId>mosip-vivid-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>testkit</artifactId>
  <name>testkit</name>
  <description>ISO/IEC 30107-3 evaluation metrics and reports, corpus scorer, FaceFrameSource conformance suite, scenario runner and latency benchmark. The metrics, conformance, scenario and bench packages use liveness-api only; the corpus package (CorpusScoreMain) drives the real liveness-core orchestrator and ONNX engine, which are OPTIONAL dependencies so they never reach testkit consumers transitively.</description>

  <!-- Test and tooling module, not shipped in a Registration Client: stays on Java 17. -->
  <properties><maven.compiler.release>17</maven.compiler.release></properties>

  <dependencies>
    <dependency><groupId>io.mosip.vivid</groupId><artifactId>liveness-api</artifactId></dependency>
    <dependency><groupId>io.mosip.vivid</groupId><artifactId>device-api</artifactId></dependency>
    <dependency><groupId>io.mosip.vivid</groupId><artifactId>device-mock</artifactId></dependency>
    <!-- Optional: only io.mosip.vivid.testkit.corpus (CorpusScoreMain) uses them. No cycle: neither module depends on
         testkit. Optional keeps them off the classpath of adapter authors who depend on testkit for the conformance suite. -->
    <dependency><groupId>io.mosip.vivid</groupId><artifactId>liveness-core</artifactId><optional>true</optional></dependency>
    <dependency><groupId>io.mosip.vivid</groupId><artifactId>liveness-engine-onnx</artifactId><optional>true</optional></dependency>
    <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId></dependency>
    <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-api</artifactId></dependency>
    <!-- compile scope on purpose: FrameSourceConformanceTest is an abstract JUnit base class shipped to adapter authors -->
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter-api</artifactId><version>${junit.version}</version></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.assertj</groupId><artifactId>assertj-core</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-simple</artifactId><scope>test</scope></dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables><java.awt.headless>true</java.awt.headless></systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
