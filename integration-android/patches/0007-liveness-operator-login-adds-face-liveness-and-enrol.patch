+
+package io.mosip.registration_client.liveness;
+
+import android.graphics.Bitmap;
+import android.util.Log;
+
+import androidx.annotation.NonNull;
+
+import java.util.ArrayList;
+import java.util.List;
+
+import io.mosip.registration.clientmanager.entity.UserBiometric;
+import io.mosip.registration.clientmanager.repository.UserBiometricRepository;
+import io.mosip.vivid.android.face.EnrolledFaceProvider;
+
+/**
+ * Enrolled operator / supervisor faces for mosip-vivid's login face match.
+ *
+ * <p>Operator onboarding ({@code UserOnboardService.save}) stores one {@code user_biometric} row per captured
+ * attribute; for the face the {@code bio_template} column holds the raw ISO/IEC 19794-5 record from the SBI
+ * ({@code BIR.getBdb()} = base64url-decoded {@code bioValue}), not a vendor template: ARC 1.2.x has no Android
+ * extraction SDK ({@code getExtractedTemplates} keeps the BIRs as they are). The database is SQLCipher-encrypted
+ * at rest, but Room hands back plaintext, so the record can be decoded ({@link IsoFaceImages}) and embedded with the
+ * same MobileFaceNet as the live session.
+ *
+ * <p>Rows are matched to the user case-insensitively on {@code usr_id}. Rows written before the
+ * {@code UserOnboardService} fix in this patch series have {@code usr_id = ""} and cannot be attributed to anyone; they
+ * are ignored, so those operators count as "no enrolled face" until they onboard again.
+ */
+public class ArcEnrolledFaceProvider implements EnrolledFaceProvider {
+
+    private static final String TAG = "ArcEnrolledFaceProvider";
+    private static final String FACE = "Face";
+
+    private final UserBiometricRepository userBiometricRepository;
+
+    public ArcEnrolledFaceProvider(UserBiometricRepository userBiometricRepository) {
+        this.userBiometricRepository = userBiometricRepository;
+    }
+
+    @NonNull
+    @Override
+    public Enrolled enrolledFaces(@NonNull String userId) {
+        String id = userId.trim();
+        List<Bitmap> images = new ArrayList<>();
+        int records = 0;
+        if (id.isEmpty()) return new Enrolled(0, images);
+        List<UserBiometric> rows = userBiometricRepository.findAllOperatorBiometrics(FACE);
+        if (rows == null) return new Enrolled(0, images);
+        for (UserBiometric row : rows) {
+            if (row == null || !id.equalsIgnoreCase(row.getUsrId()) || Boolean.TRUE.equals(row.getIsDeleted())) continue;
+            records++;
+            Bitmap image = IsoFaceImages.fromIso(row.getBioTemplate());
+            if (image != null) {
+                images.add(image);
+            } else {
+                Log.w(TAG, "Enrolled face record " + row.getBioAttributeCode() + " could not be decoded");
+            }
+        }
+        return new Enrolled(records, images);
+    }
+}
