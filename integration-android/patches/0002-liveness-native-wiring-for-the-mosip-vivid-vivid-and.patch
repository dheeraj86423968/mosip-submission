@@ -0,0 +1,76 @@
+/*
+ * Copyright (c) Modular Open Source Identity Platform
+ * This source code is licensed under the MIT license found in the
+ * LICENSE file in the root directory of this source tree.
+ *
+ */
+
+package io.mosip.registration_client.liveness;
+
+import android.content.Context;
+import android.net.ConnectivityManager;
+import android.net.NetworkCapabilities;
+import android.util.Log;
+
+import io.mosip.registration.clientmanager.constant.AuditEvent;
+import io.mosip.registration.clientmanager.constant.Components;
+import io.mosip.registration.clientmanager.repository.GlobalParamRepository;
+import io.mosip.registration.clientmanager.spi.AuditManagerService;
+import io.mosip.vivid.android.bridge.LivenessPigeonApi;
+import io.mosip.vivid.android.engine.MediaPipeLivenessEngine;
+import io.mosip.vivid.android.engine.ModelAssets;
+import io.mosip.vivid.android.face.EnrolledFaceProvider;
+import kotlin.Unit;
+
+/**
+ * Wires the mosip-vivid {@link LivenessPigeonApi} into the registration client: the MediaPipe/TFLite engine
+ * (models from an installed bundle in {@code filesDir/vivid/models/current}, else the APK assets), network state,
+ * the client's audit log ({@link Components#LIVENESS}) and policy from global params ({@link LivenessPolicySource}).
+ */
+public final class ArcLiveness {
+
+    private static final String TAG = "ArcLiveness";
+
+    private ArcLiveness() {
+    }
+
+    public static LivenessPigeonApi create(Context appContext, AuditManagerService auditManagerService,
+                                           GlobalParamRepository globalParamRepository,
+                                           EnrolledFaceProvider enrolledFaceProvider) {
+        LivenessPolicySource policySource = new LivenessPolicySource(globalParamRepository);
+        return new LivenessPigeonApi(
+                appContext,
+                (ctx, governor) -> new MediaPipeLivenessEngine(ctx,
+                        ModelAssets.Companion.load(ctx, ModelAssets.Companion.defaultBundleDir(ctx)), governor, true),
+                () -> isOnline(appContext),
+                (event, sessionId, detail) -> {
+                    audit(auditManagerService, event, sessionId, detail);
+                    return Unit.INSTANCE;
+                },
+                policySource::policyJson,
+                enrolledFaceProvider);
+    }
+
+    /** Maps a vivid {@code LIVENESS_*} event name onto {@link AuditEvent}; unknown names are logged, not dropped silently. */
+    public static void audit(AuditManagerService auditManagerService, String event, String sessionId, String detail) {
+        try {
+            AuditEvent auditEvent = AuditEvent.valueOf(event);
+            auditManagerService.auditWithArguments(auditEvent, Components.LIVENESS.getId(), Components.LIVENESS.getName(),
+                    sessionId == null ? "" : sessionId, detail == null ? "" : detail);
+        } catch (IllegalArgumentException e) {
+            Log.w(TAG, "No AuditEvent for liveness event " + event + " (session " + sessionId + ", " + detail + ")");
+        } catch (Exception e) {
+            Log.e(TAG, "Liveness audit failed for " + event, e);
+        }
+    }
+
+    private static boolean isOnline(Context context) {
+        try {
+            ConnectivityManager cm = (ConnectivityManager) context.getSystemService(Context.CONNECTIVITY_SERVICE);
+            NetworkCapabilities caps = cm == null ? null : cm.getNetworkCapabilities(cm.getActiveNetwork());
+            return caps != null && caps.hasCapability(NetworkCapabilities.NET_CAPABILITY_INTERNET);
+        } catch (Exception e) {
+            return false;
+        }
+    }
+}
diff --git a/android/app/src/main/java/io/mosip/registration_client/liveness/LivenessPolicySource.java b/android/app/src/main/java/io/mosip/registration_client/liveness/LivenessPolicySource.java
new file mode 100644
index 0000000..4956719
--- /dev/null
+++ b/android/app/src/main/java/io/mosip/registration_client/liveness/LivenessPolicySource.java
@@ -0,0 +1,108 @@
+/*
+ * Copyright (c) Modular Open Source Identity Platform
+ * This source code is licensed under the MIT license found in the
+ * LICENSE file in the root directory of this source tree.
+ *
+ */
+
+package io.mosip.registration_client.liveness;
+
+import android.util.Log;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.util.Locale;
+import java.util.Map;
+
+import io.mosip.registration.clientmanager.repository.GlobalParamRepository;
+
+/**
+ * Builds the per-workflow liveness policy JSON (the format read by vivid-android's {@code PolicyJson} and
+ * {@code FaceMatchPolicy}) from synced global params. Nothing is required: absent keys keep the compiled-in
+ * {@code LivenessPolicy.defaults(workflow)}.
+ *
+ * <pre>
+ * mosip.registration.liveness.enabled                         = false      master switch for all workflows
+ * mosip.registration.liveness.&lt;workflow&gt;.policy               = {...}      full JSON document (optional base)
+ * mosip.registration.liveness.&lt;workflow&gt;.&lt;field&gt;              = value      e.g. operator.passiveThreshold=0.88
+ * mosip.registration.liveness.&lt;workflow&gt;.faceMatch.&lt;field&gt;    = value      e.g. operator.faceMatch.threshold=0.55
+ * </pre>
+ * {@code <workflow>} is resident, operator or supervisor. Values "true"/"false" become booleans, numbers become
+ * numbers, values starting with '[' or '{' are parsed as JSON, anything else stays a string.
+ */
+public class LivenessPolicySource {
+
+    private static final String TAG = "LivenessPolicySource";
+    static final String PREFIX = "mosip.registration.liveness.";
+
+    private final GlobalParamRepository globalParamRepository;
+
+    public LivenessPolicySource(GlobalParamRepository globalParamRepository) {
+        this.globalParamRepository = globalParamRepository;
+    }
+
+    /** @return the policy JSON for {@code workflow} (RESIDENT, OPERATOR, SUPERVISOR), or null when nothing is configured. */
+    public String policyJson(String workflow) {
+        String wf = workflow.trim().toLowerCase(Locale.ROOT);
+        try {
+            Map<String, Object> params = globalParamRepository.getGlobalParamsByPattern(PREFIX + "%");
+            return build(wf, params);
+        } catch (Exception e) {
+            Log.e(TAG, "Failed to read liveness policy for " + wf + "; using compiled-in defaults", e);
+            return null;
+        }
+    }
+
+    static String build(String wf, Map<String, Object> params) throws JSONException {
+        if (params == null || params.isEmpty()) return null;
+        String wfPrefix = PREFIX + wf + ".";
+        JSONObject root = new JSONObject();
+        Object base = params.get(wfPrefix + "policy");
+        if (base != null && !base.toString().trim().isEmpty()) {
+            root = new JSONObject(base.toString().trim());
+        }
+        boolean any = root.length() > 0;
+        for (Map.Entry<String, Object> e : params.entrySet()) {
+            String key = e.getKey();
+            if (!key.startsWith(wfPrefix) || key.equals(wfPrefix + "policy") || e.getValue() == null) continue;
+            String[] path = key.substring(wfPrefix.length()).split("\\.");
+            JSONObject node = root;
+            for (int i = 0; i < path.length - 1; i++) {
+                JSONObject child = node.optJSONObject(path[i]);
+                if (child == null) {
+                    child = new JSONObject();
+                    node.put(path[i], child);
+                }
+                node = child;
+            }
+            node.put(path[path.length - 1], parseValue(e.getValue().toString().trim()));
+            any = true;
+        }
+        Object master = params.get(PREFIX + "enabled");
+        if (master != null && "false".equalsIgnoreCase(master.toString().trim())) {
+            root.put("enabled", false);
+            any = true;
+        }
+        return any ? root.toString() : null;
+    }
+
+    static Object parseValue(String v) {
+        if ("true".equalsIgnoreCase(v)) return Boolean.TRUE;
+        if ("false".equalsIgnoreCase(v)) return Boolean.FALSE;
+        try {
+            if (v.startsWith("[")) return new JSONArray(v);
+            if (v.startsWith("{")) return new JSONObject(v);
+        } catch (JSONException ignored) {
+            return v;
+        }
+        try {
+            if (v.matches("-?\\d+")) return Long.parseLong(v);
+            if (v.matches("-?\\d*\\.\\d+([eE]-?\\d+)?")) return Double.parseDouble(v);
+        } catch (NumberFormatException ignored) {
+            // fall through
+        }
+        return v;
+    }
+}
