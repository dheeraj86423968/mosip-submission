@@ -0,0 +1,70 @@
+/*
+ * Copyright (c) Modular Open Source Identity Platform
+ * This source code is licensed under the MIT license found in the
+ * LICENSE file in the root directory of this source tree.
+ *
+ */
+
+package io.mosip.registration_client.liveness;
+
+import android.graphics.Bitmap;
+import android.os.Handler;
+import android.os.Looper;
+import android.util.Log;
+
+import java.util.List;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+
+import io.mosip.registration.clientmanager.dto.registration.BiometricsDto;
+import io.mosip.vivid.android.bridge.LivenessPigeonApi;
+import io.mosip.vivid.android.face.FaceMatchOutcome;
+
+/**
+ * Binds a resident's signed SBI face capture to the liveness session that ran just before it: the face in the
+ * {@code rcapture} image must match the anchor embedding of the most recent PASSED RESIDENT session
+ * ({@link LivenessPigeonApi#bindCapture}). This stops a passed liveness check being followed by a capture of
+ * someone (or something) else. Decoding and embedding take a few hundred ms, so they run off the main thread;
+ * the callbacks run on the main thread. The outcome is audited by the bridge (LIVENESS_CAPTURE_BOUND /
+ * LIVENESS_IDENTITY_DRIFT). When liveness or face matching is disabled by policy, every capture is accepted.
+ */
+public class LivenessCaptureBinder {
+
+    private static final String TAG = "LivenessCaptureBinder";
+    /** What {@code BiometricsApi.invokeDiscoverSbi} resolves with when the capture is rejected (see liveness_flow.dart). */
+    public static final String CAPTURE_MISMATCH = "LIVENESS_CAPTURE_MISMATCH";
+
+    private final LivenessPigeonApi livenessPigeonApi;
+    private final ExecutorService executor = Executors.newSingleThreadExecutor();
+    private final Handler mainHandler = new Handler(Looper.getMainLooper());
+
+    public LivenessCaptureBinder(LivenessPigeonApi livenessPigeonApi) {
+        this.livenessPigeonApi = livenessPigeonApi;
+    }
+
+    public void verifyThen(List<BiometricsDto> faceCaptures, Runnable onAccepted, Runnable onRejected) {
+        String bioValue = null;
+        if (faceCaptures != null) {
+            for (BiometricsDto dto : faceCaptures) {
+                if (dto != null && dto.getBioValue() != null && !dto.getBioValue().isEmpty()) {
+                    bioValue = dto.getBioValue();
+                    break;
+                }
+            }
+        }
+        final String probe = bioValue;
+        executor.execute(() -> {
+            boolean accepted;
+            try {
+                Bitmap image = IsoFaceImages.fromBioValue(probe);
+                FaceMatchOutcome outcome = livenessPigeonApi.bindCapture(image);
+                Log.i(TAG, "capture binding: " + outcome.getStatus() + " accepted=" + outcome.getAccepted());
+                accepted = outcome.getAccepted();
+            } catch (Exception e) {
+                Log.e(TAG, "capture binding failed; rejecting the capture", e);
+                accepted = false;
+            }
+            mainHandler.post(accepted ? onAccepted : onRejected);
+        });
+    }
+}
