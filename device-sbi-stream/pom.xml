<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.mosip.vivid</groupId>
    <artifactId>mosip-vivid-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>device-sbi-stream</artifactId>
  <name>device-sbi-stream</name>
  <description>Desktop FaceFrameSource adapter that discovers MOSIP SBI face devices on 127.0.0.1:4501-4600 and consumes the STREAM /stream MJPEG endpoint.</description>

  <dependencies>
    <dependency><groupId>io.mosip.vivid</groupId><artifactId>device-api</artifactId></dependency>
    <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId></dependency>
    <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-api</artifactId></dependency>
    <dependency><groupId>io.mosip.vivid</groupId><artifactId>device-mock</artifactId><scope>test</scope></dependency>
    <!-- FrameSourceConformanceTest, run against device-mock's MockSbiServer and (opt-in) MOSIP's MockMDS -->
    <dependency><groupId>io.mosip.vivid</groupId><artifactId>testkit</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.assertj</groupId><artifactId>assertj-core</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-simple</artifactId><scope>test</scope></dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <java.awt.headless>true</java.awt.headless>
            <!-- opt-in interop run against MOSIP's MockMDS: -Dvivid.interop.mockmds=4501 (see tools/interop-mockmds.sh) -->
            <vivid.interop.mockmds>${vivid.interop.mockmds}</vivid.interop.mockmds>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
