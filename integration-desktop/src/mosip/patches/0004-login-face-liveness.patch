--- /dev/null
+++ b/registration/registration-services/src/main/java/io/mosip/registration/service/bio/FaceAuthLivenessGuard.java
@@ -0,0 +1,30 @@
+package io.mosip.registration.service.bio;
+
+import java.util.List;
+
+import io.mosip.registration.dto.packetmanager.BiometricsDto;
+import io.mosip.registration.exception.RegBaseCheckedException;
+
+/**
+ * Optional face liveness / presentation-attack guard around operator face authentication at login
+ * ({@code SessionContext.validateFace}). Implemented outside registration-services (mosip-vivid
+ * {@code io.mosip.vivid.desktop.mosip.OperatorAuthLivenessHook}, packaged with registration-client), looked up from
+ * the Spring context and skipped when no bean exists, so registration-services has no compile-time dependency on it.
+ */
+public interface FaceAuthLivenessGuard {
+
+	/**
+	 * Runs before {@code BioService.captureModalityForAuth}. Opens its own SBI stream.
+	 *
+	 * @return {@code true} when liveness is disabled by policy or the session was accepted; {@code false} rejects the login
+	 */
+	boolean beforeFaceAuthCapture(String userId) throws RegBaseCheckedException;
+
+	/**
+	 * Runs after the signed capture and before {@code AuthenticationService.authValidator}: binds the captured face to
+	 * the liveness session (identity continuity).
+	 *
+	 * @return {@code true} when not required or bound; {@code false} rejects the login
+	 */
+	boolean afterFaceAuthCapture(String userId, List<BiometricsDto> biometrics);
+}
