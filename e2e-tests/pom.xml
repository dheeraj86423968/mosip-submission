<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>io.mosip.vivid</groupId><artifactId>mosip-vivid-parent</artifactId><version>0.1.0-SNAPSHOT</version><relativePath>../pom.xml</relativePath></parent>
  <artifactId>e2e-tests</artifactId>
  <name>e2e-tests</name>
  <description>End-to-end tests wiring the real mock device, SBI stream reader, liveness-core orchestrator and ONNX engine together.</description>
  <!-- Test and tooling module, not shipped in a Registration Client: stays on Java 17. -->
  <properties><maven.compiler.release>17</maven.compiler.release><maven.deploy.skip>true</maven.deploy.skip><maven.install.skip>true</maven.install.skip></properties>
  <dependencies>
    <dependency><groupId>io.mosip.vivid</groupId><artifactId>liveness-core</artifactId><scope>test</scope></dependency>
    <dependency><groupId>io.mosip.vivid</groupId><artifactId>liveness-engine-onnx</artifactId><scope>test</scope></dependency>
    <dependency><groupId>io.mosip.vivid</groupId><artifactId>device-mock</artifactId><scope>test</scope></dependency>
    <dependency><groupId>io.mosip.vivid</groupId><artifactId>testkit</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.assertj</groupId><artifactId>assertj-core</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-simple</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build><plugins><plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId>
    <configuration><environmentVariables><MOSIP_VIVID_MODELS>${project.basedir}/../liveness-engine-onnx/models</MOSIP_VIVID_MODELS></environmentVariables><systemPropertyVariables><org.slf4j.simpleLogger.defaultLogLevel>warn</org.slf4j.simpleLogger.defaultLogLevel></systemPropertyVariables></configuration>
  </plugin></plugins></build>
</project>
