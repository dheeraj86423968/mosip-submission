<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.mosip.vivid</groupId>
  <artifactId>mosip-vivid-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>MOSIP Vivid - Face Liveness and PAD for Registration Clients</name>
  <description>Vendor-neutral, offline-first face liveness and presentation attack detection for MOSIP Registration Clients.</description>
  <licenses><license><name>MPL-2.0</name><url>https://www.mozilla.org/en-US/MPL/2.0/</url></license></licenses>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.11.4</junit.version>
    <jackson.version>2.18.2</jackson.version>
    <slf4j.version>2.0.16</slf4j.version>
  </properties>

  <modules>
    <module>liveness-api</module>
    <module>device-api</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency><groupId>io.mosip.vivid</groupId><artifactId>liveness-api</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.mosip.vivid</groupId><artifactId>device-api</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.mosip.vivid</groupId><artifactId>liveness-core</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.mosip.vivid</groupId><artifactId>policy</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.mosip.vivid</groupId><artifactId>device-mock</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.mosip.vivid</groupId><artifactId>telemetry</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.mosip.vivid</groupId><artifactId>liveness-engine-onnx</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.mosip.vivid</groupId><artifactId>model-bundle</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.mosip.vivid</groupId><artifactId>testkit</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId><version>${jackson.version}</version></dependency>
      <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-api</artifactId><version>${slf4j.version}</version></dependency>
      <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-simple</artifactId><version>${slf4j.version}</version></dependency>
      <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>${junit.version}</version><scope>test</scope></dependency>
      <dependency><groupId>org.assertj</groupId><artifactId>assertj-core</artifactId><version>3.27.3</version><scope>test</scope></dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version></plugin>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.2</version></plugin>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.4.2</version></plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
